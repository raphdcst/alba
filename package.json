{
  "name": "alba",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "@cloudflare/workers-types": "^5.20261112.1",
      "@orpc/server": "^1.16.2",
      "@orpc/openapi": "^1.16.2",
      "@orpc/zod": "^1.16.2",
      "better-auth": "1.7.22",
      "evlog": "^2.35.1",
      "@orpc/client": "^1.16.2",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F hono --",
    "db:push": "turbo run db:push -F @alba/db --",
    "db:studio": "turbo run db:studio -F @alba/db --",
    "db:generate": "turbo run db:generate -F @alba/db --",
    "db:migrate": "turbo run db:migrate -F @alba/db --",
    "deploy": "turbo run deploy -F @alba/infra --",
    "destroy": "turbo run destroy -F @alba/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alba/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "overrides": {
    "@vue/devtools-api": "^8.2.1"
  },
  "packageManager": "bun@1.4.4"
}
